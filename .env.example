# Copia este archivo como .env y pon tus datos locales (.env NO se sube a GitHub)

# PostgreSQL en la nube (Neon / Render): si DATABASE_URL existe, se usa en lugar de las DB_* de abajo.
# SSL queda activo; pon DB_SSL=false solo si tu servidor no usa SSL.
# DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EvaluacionDocentes
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres

# Clave para firmar los JWT (cualquier texto largo y secreto)
JWT_SECRET=cambia_esto_por_un_texto_largo_y_secreto

# Puerto del backend (el frontend de Vite usa 8443 y reenvía /api aquí)
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:8443

# Configuración del servicio de correo SMTP (Recuperación de contraseña)
# Ejemplo con Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
#
# Ejemplo con servidor de pruebas (Ethereal / Mailtrap):
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
